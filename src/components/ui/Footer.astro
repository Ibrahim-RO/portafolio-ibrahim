---
import { Picture } from "astro:assets";
import LogoIbrahim from "@/assets/IbrahimRO.png";
import { navigation } from "../../data/navigation";
---

<footer
    class="text-white bg-primary text-center py-8 space-y-8 border-b border-white/10 shadow-[0_0_10px_rgba(0,229,192,0.1)]"
>
    <section
        class="max-w-7xl mx-auto flex flex-col lg:flex-row justify-between items-center gap-5 px-10"
    >
        <div>
            <a href="#" class="group flex items-center gap-2">
                <span class="font-black text-3xl text-cyan-400">{"<"}</span>

                <span
                    class="font-black text-xl uppercase tracking-wider text-white"
                    >Ibrahim</span
                >

                <span class="font-black text-3xl text-cyan-400">{"/>"}</span
                >

                <div class="h-2 w-2 rounded-full bg-cyan-400 animate-pulse">
                </div>
            </a>
        </div>
        <div class="flex justify-center flex-wrap gap-4">
            {
                navigation.map((item) => (
                    <a href={item.href} class="hover:underline">
                        {item.name}
                    </a>
                ))
            }
        </div>
    </section>
    <p>
        &copy; {new Date().getFullYear()} - Todos los derechos reservados. <b
            >Ibrahim Rodríguez Olaya.</b
        >
    </p>
</footer>
