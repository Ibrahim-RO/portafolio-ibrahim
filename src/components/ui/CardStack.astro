---
import type { Technology } from "../../types"
interface Props {
    technology: Technology
}

const { technology } = Astro.props;
---

<div class="group relative overflow-hidden border border-cyan-500/20 bg-white/5 transition-all duration-500 hover:border-cyan-400/50 hover:shadow-[0_0_40px_rgba(0,255,255,0.08)]">

    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(0,255,255,0.08),transparent_60%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
        
    <div class="relative space-y-5 p-6">
        <div class="space-y-3 text-center">
            <h3
                class="text-2xl font-black uppercase tracking-wide text-gray-100 transition-colors duration-300 group-hover:text-cyan-300"
            >
                {technology.name}
            </h3>

            <ul>
                {technology.technologies.map(item => (
                    <li>{item}</li>
                ))}
            </ul>
        </div>
    </div>

    <div
        class="absolute bottom-0 left-0 h-px w-0 bg-cyan-400 transition-all duration-500 group-hover:w-full"
    >
    </div>
</div>
