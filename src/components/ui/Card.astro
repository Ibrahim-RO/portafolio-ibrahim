---
import Badge from "./Badge.astro";
---

<div
    class="group relative overflow-hidden border border-cyan-500/20 bg-[#06090f] transition-all duration-500 hover:border-cyan-400/50 hover:shadow-[0_0_40px_rgba(0,255,255,0.08)]"
>
    {/* glow */}
    <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(0,255,255,0.08),transparent_60%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    >
    </div>

    {/* top code */}
    <div class="absolute right-4 top-4 z-10">
        <span
            class="border border-cyan-400/40 bg-cyan-400/10 px-2 py-1 text-[10px] font-medium tracking-[0.2em] text-cyan-300"
        >
            PX-001
        </span>
    </div>

    {/* image */}
    <div class="relative overflow-hidden border-b border-cyan-500/10">
        <img
            src="https://ibrahimro-dev.netlify.app/radiobears.webp"
            alt=""
            class="h-65 w-full object-cover grayscale transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
        />

        {/* overlay */}
        <div
            class="absolute inset-0 bg-linear-to-t from-[#06090f] via-[#06090f]/40 to-transparent"
        >
        </div>
    </div>

    {/* content */}
    <div class="relative space-y-5 p-6">
        <div class="space-y-3">
            <h3
                class="text-2xl font-black uppercase tracking-wide text-gray-100 transition-colors duration-300 group-hover:text-cyan-300"
            >
                ORION_CMS
            </h3>

            <p class="text-sm leading-relaxed text-gray-400">
                Plataforma fullstack enfocada en gestión de contenido,
                autenticación, APIs y dashboards administrativos en tiempo real.
            </p>
        </div>

        {/* stack */}
        <div class="flex flex-wrap gap-2">
            <Badge text="NEXT.JS" />
            <Badge text="TYPESCRIPT" />
            <Badge text="DJANGO" />
            <Badge text="POSTGRES" />
        </div>

        {/* actions */}
        <div class="flex gap-3 pt-2">
            <a
                href="#"
                class="group/btn relative overflow-hidden border border-cyan-400 bg-cyan-400 px-5 py-3 text-xs font-bold uppercase tracking-[0.18em] text-black transition-all duration-300 hover:shadow-[0_0_25px_rgba(34,211,238,0.35)]"
            >
                <span class="relative z-10">View Project</span>

                <div
                    class="absolute inset-0 -translate-x-full bg-white/20 transition-transform duration-500 group-hover/btn:translate-x-0"
                >
                </div>
            </a>

            <a
                href="#"
                class="border border-cyan-500/30 bg-transparent px-5 py-3 text-xs font-bold uppercase tracking-[0.18em] text-cyan-300 transition-all duration-300 hover:border-cyan-400 hover:bg-cyan-400/10 hover:text-cyan-200"
            >
                Source Code
            </a>
        </div>
    </div>

    {/* bottom line */}
    <div
        class="absolute bottom-0 left-0 h-px w-0 bg-cyan-400 transition-all duration-500 group-hover:w-full"
    >
    </div>
</div>
