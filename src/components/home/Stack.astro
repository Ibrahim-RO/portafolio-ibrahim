---
import CardStack from "../ui/CardStack.astro";
import SectionContainer from "../ui/SectionContainer.astro";
import Title from "../ui/Title.astro";
import { technologies } from "../../data/stack";
---

<SectionContainer>
    <div id="tech" class="space-y-8 scroll-mt-24">
        <Title title="Mi Stack Tecnológico" />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
            {
                technologies.map((technology) => (
                    <CardStack technology={technology} />
                ))
            }
        </div>
    </div>
</SectionContainer>
