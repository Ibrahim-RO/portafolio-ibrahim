---
const stats = [
  { value: "2", label: "Años Exp." },
  { value: "10", label: "Proyectos" },
  { value: "3", label: "Clientes" },
];
---

<section class="relative h-screen overflow-hidden bg-[#050B0F]">

  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(0,217,255,0.15),transparent_60%)]"></div>

    <div
      class="absolute inset-0 opacity-20
      bg-[linear-gradient(rgba(0,217,255,0.15)_1px,transparent_1px),linear-gradient(90deg,rgba(0,217,255,0.15)_1px,transparent_1px)]
      bg-size-[60px_60px]"
    ></div>

    <div class="absolute top-20 left-20 h-96 w-96 rounded-full bg-cyan-500/20 blur-[180px]"></div>
    <div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-blue-500/20 blur-[180px]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 py-28">

    <div class="grid items-center gap-16 lg:grid-cols-2">

      <div>
        <span class="inline-flex items-center border border-cyan-400/30 bg-cyan-500/10 px-4 py-2 text-xs tracking-[0.3em] text-cyan-300 uppercase">
          Full Stack Developer
        </span>

        <h1 class="mt-6 text-5xl font-black uppercase leading-none text-white md:text-7xl">
          Construyo <span class="block text-cyan-400">experiencias</span> digitales
        </h1>

        <p class="mt-8 max-w-xl text-lg leading-relaxed text-slate-400">
          Desarrollo aplicaciones web modernas utilizando React, Astro, Next.js, Node.js y PostgreSQL. Diseño soluciones rápidas, escalables y enfocadas en la experiencia del usuario.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="#projects"
            class="bg-cyan-400 px-8 py-4 font-bold uppercase tracking-[0.2em] text-black transition hover:scale-105"
          >
            Ver Proyectos
          </a>

          <a
            href="#contact"
            class="border border-cyan-400/40 px-8 py-4 font-bold uppercase tracking-[0.2em] text-cyan-300 transition hover:bg-cyan-400/10"
          >
            Contactar
          </a>

        </div>

        <div class="mt-14 flex gap-8">

          {stats.map((stat) => (
            <div>
              <div class="text-3xl font-black text-cyan-400">
                {stat.value}
              </div>

              <div class="text-sm uppercase tracking-widest text-slate-500">
                {stat.label}
              </div>
            </div>
          ))}

        </div>

      </div>

      <div class="relative">

        <div class="absolute -inset-5 rounded-3xl bg-cyan-500/20 blur-3xl"></div>

        <div class="relative overflow-hidden rounded-3xl border border-cyan-400/20 bg-[#08131B]/90 backdrop-blur-xl">

          <div class="flex items-center gap-2 border-b border-cyan-400/10 p-4">
            <div class="h-3 w-3 rounded-full bg-red-500"></div>
            <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
            <div class="h-3 w-3 rounded-full bg-green-500"></div>

            <span
              class="ml-auto text-xs uppercase tracking-[0.3em] text-cyan-400"
            >
              portfolio.tsx
            </span>
          </div>

          <div
            class="space-y-4 p-8 font-mono text-sm text-cyan-300"
          >
            <p>
              const developer = &#123;
            </p>

            <p class="pl-6">
              name: "Ibrahim",
            </p>

            <p class="pl-6">
              stack: ["Astro", "React", "Node"],
            </p>

            <p class="pl-6">
              passion: "Building products",
            </p>

            <p class="pl-6">
              status: "Available for work"
            </p>

            <p>
              &#125;
            </p>
          </div>

          <div
            class="border-t border-cyan-400/10 p-6"
          >
            <div class="flex flex-wrap gap-3">

              <span class="border border-cyan-400/30 px-3 py-2 text-xs uppercase tracking-widest text-cyan-300">
                Astro
              </span>

              <span class="border border-cyan-400/30 px-3 py-2 text-xs uppercase tracking-widest text-cyan-300">
                React/NextJS
              </span>

              <span class="border border-cyan-400/30 px-3 py-2 text-xs uppercase tracking-widest text-cyan-300">
                TypeScript
              </span>

              <span class="border border-cyan-400/30 px-3 py-2 text-xs uppercase tracking-widest text-cyan-300">
                Python
              </span>

              <span class="border border-cyan-400/30 px-3 py-2 text-xs uppercase tracking-widest text-cyan-300">
                PostgreSQL
              </span>

            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>